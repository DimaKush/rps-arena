{
  "name": "rps-arena",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/hardhat",
      "packages/nextjs"
    ]
  },
  "scripts": {
    "next:build": "yarn workspace @rps-arena/nextjs build",
    "start": "yarn workspace @rps-arena/nextjs dev",
    "next:check-types": "yarn workspace @rps-arena/nextjs check-types",
    "next:lint": "yarn workspace @rps-arena/nextjs lint",
    "vercel": "yarn workspace @rps-arena/nextjs vercel",
    "ipfs": "yarn workspace @rps-arena/nextjs ipfs",
    "postinstall": "husky",
    "precommit": "lint-staged"
  },
  "packageManager": "yarn@3.2.3",
  "devDependencies": {
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10"
  },
  "engines": {
    "node": ">=20.18.3"
  }
}
